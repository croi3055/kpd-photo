{
  "previousItem": {
    "keys": ["leftArrow"],
    "display": ["←"]
  },
  "nextItem": {
    "keys": ["rightArrow"],
    "display": ["→"]
  },
  "keepItem": {
    "keys": ["downArrow"],
    "display": ["↓"]
  },
  "moveToTrash": {
    "keys": ["upArrow", "w"],
    "display": ["↑"]
  },
  "openTrashBin": {
    "keys": ["delete"],
    "display": ["Delete"]
  },
  "toggleTimeInfo": {
    "keys": ["i"],
    "display": ["I"]
  },
  "undo": {
    "keys": ["z"],
    "display": ["Z"]
  },
  "closeWindow": {
    "keys": ["escape"],
    "display": ["Esc"]
  }
}
