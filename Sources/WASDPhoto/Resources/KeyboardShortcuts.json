{
  "previousItem": {
    "keys": ["leftArrow"],
    "display": ["←"]
  },
  "nextItem": {
    "keys": ["rightArrow"],
    "display": ["→"]
  },
  "moveToTrash": {
    "keys": ["upArrow", "w"],
    "display": ["↑"]
  },
  "openTrashBin": {
    "keys": ["delete"],
    "display": ["Delete"]
  },
  "undo": {
    "keys": ["z", "downArrow"],
    "display": ["Z", "↓"]
  },
  "closeWindow": {
    "keys": ["escape"],
    "display": ["Esc"]
  }
}
